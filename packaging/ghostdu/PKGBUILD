# Maintainer: Ron <ron@example.com>
pkgname=ghostdu
pkgver=0.1.0
pkgrel=1
pkgdesc="High-performance TUI disk usage analyzer and ghost space detector"
arch=('x86_64' 'aarch64')
url="https://github.com/ronimuliawan-coder/ghostdu"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
# Upstream tags are stable; run `updpkgsums` when bumping pkgver.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/ghostdu" "$pkgdir/usr/bin/ghostdu"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # The binary generates its own man page and completions.
  ./target/release/ghostdu --print-manpage > ghostdu.1
  install -Dm644 ghostdu.1 "$pkgdir/usr/share/man/man1/ghostdu.1"
  ./target/release/ghostdu --print-completions bash > ghostdu.bash
  install -Dm644 ghostdu.bash "$pkgdir/usr/share/bash-completion/completions/ghostdu"
  ./target/release/ghostdu --print-completions zsh > _ghostdu
  install -Dm644 _ghostdu "$pkgdir/usr/share/zsh/site-functions/_ghostdu"
  ./target/release/ghostdu --print-completions fish > ghostdu.fish
  install -Dm644 ghostdu.fish "$pkgdir/usr/share/fish/vendor_completions.d/ghostdu.fish"
}
